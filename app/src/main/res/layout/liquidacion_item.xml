<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Contenedor de Textos (Izquierda) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFolioLiquidacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Folio: #12345"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#212121"/>

            <TextView
                android:id="@+id/tvOperadorLiquidacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Operador: Juan Pérez"
                android:textColor="#757575"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Contenedor del Pago (Derecha) -->
        <TextView
            android:id="@+id/tvPagoLiquidacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="$1,500.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
