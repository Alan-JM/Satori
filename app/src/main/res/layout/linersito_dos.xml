<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/transparent">

        <!-- Sección Izquierda: Folio y Contra -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFolioOp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Folio: 0001"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvContraOp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Contraseña: 1234"
                android:textColor="#757575"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Sección Central: Fecha de Entrega -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha entrega:"
                android:textColor="@color/naranja_boton"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/tvFechaEntregaOp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25/10/2024 14:30"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Sección Derecha: Iconos -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="top"> <!-- alineados arriba -->

            <ImageView
                android:id="@+id/imgEnviadoOp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/triangulor"
                app:tint="@color/naranja_boton"
                android:layout_gravity="top"/>

            <ImageView
                android:id="@+id/imgProgresoOp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/triangulo"
                app:tint="@color/blue"
                android:layout_gravity="top"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
