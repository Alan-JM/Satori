<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- CONTENEDOR PRINCIPAL: Con el contorno neón rojo fijo para rechazos -->
    <LinearLayout
        android:id="@+id/cardBackgroundLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/border_neon_red"
        android:padding="3dp"
        android:orientation="vertical">

        <!-- CONTENEDOR INTERNO: Fondo blanco limpio que genera el borde delgado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_inner"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Fila superior: IdFolio y Fecha alineados con weight -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/idFolio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="IdFolio"
                    android:textColor="#AC5A2C"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rob_bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/fecha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fecha"
                    android:textColor="#666666"
                    android:textSize="15sp"
                    android:fontFamily="@font/rob_med"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Campo inferior: Motivo del rechazo (Texto oscuro sobre el fondo blanco) -->
            <TextView
                android:id="@+id/motivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motivo..."
                android:textColor="#424242"
                android:textSize="14sp"
                android:fontFamily="@font/rob_ital2"
                android:ellipsize="end"
                android:maxLines="1" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
