<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".PerfilFragment">

    <LinearLayout
        android:id="@+id/perfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado Bienvenida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/blanco_hueso"/>

            <TextView
                android:id="@+id/rolito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="ROL"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/blanco_hueso"/>
        </LinearLayout>

        <!-- Tarjeta de datos del usuario con íconos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/blanco_hueso">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Nombre -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/nombreito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre: "
                        android:textSize="18sp"
                        android:textColor="@color/negro_suave"/>
                </LinearLayout>

                <!-- Teléfono -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_phone"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/telefonoito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teléfono: "
                        android:textSize="18sp"
                        android:textColor="@color/negro_suave"/>
                </LinearLayout>

                <!-- Correo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_email"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/correito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correo: "
                        android:textSize="18sp"
                        android:textColor="@color/negro_suave"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tabla oculta para administrador -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_operadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/naranja_suave"
            android:visibility="gone">

            <TableLayout
                android:id="@+id/tabla_operadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1"
                android:padding="16dp">

                <TableRow>
                    <TextView
                        android:text="Teléfono"
                        android:textStyle="bold"
                        android:textColor="@color/blanco_hueso"/>
                    <TextView
                        android:text="Administrador"
                        android:textStyle="bold"
                        android:textColor="@color/blanco_hueso"/>
                </TableRow>

                <TableRow>
                    <TextView
                        android:id="@+id/telefono_operadorito"
                        android:text="555-1234"
                        android:textColor="@color/blanco_hueso"/>
                    <TextView
                        android:id="@+id/nombre_operadorito"
                        android:text="Operador X"
                        android:textColor="@color/blanco_hueso"/>
                </TableRow>
            </TableLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tabla exclusiva de administrador -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/naranja_suave"
            android:visibility="gone">

            <TableLayout
                android:id="@+id/tabla_admin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1"
                android:padding="16dp">

                <TableRow>
                    <TextView
                        android:text="Operadores"
                        android:textStyle="bold"
                        android:textColor="@color/blanco_hueso"/>
                    <TextView
                        android:text="Teléfono"
                        android:textStyle="bold"
                        android:textColor="@color/blanco_hueso"/>
                </TableRow>

                <TableRow>
                    <TextView
                        android:id="@+id/adminito"
                        android:text="Admin"
                        android:textColor="@color/blanco_hueso"/>
                    <TextView
                        android:id="@+id/telefono_adminito"
                        android:text="555-9999"
                        android:textColor="@color/blanco_hueso"/>
                </TableRow>
            </TableLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón de cerrar sesión -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar Sesión"
            android:textStyle="bold"
            android:textColor="@color/blanco_hueso"
            android:backgroundTint="@color/negro_suave"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"/>
    </LinearLayout>
</ScrollView>