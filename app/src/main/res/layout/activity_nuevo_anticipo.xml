<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    tools:context=".Anticipos.NuevoAnticipo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro de Anticipo"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/rob_bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"/>

        <!-- Folio -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Número de Folio"
            app:boxStrokeColor="@color/naranja_boton"
            app:hintTextColor="@color/blanco_hueso"
            android:textColorHint="@color/blanco_hueso">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/folioAnticipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="16dp"
            android:hint="       Fecha (AAAA-MM-DD)"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/naranja_boton"
            app:boxStrokeColor="@color/naranja_boton">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fechaAnticipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Operador (Unidad Trans) -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="16dp"
            android:hint="       Unidad Trans."
            app:startIconDrawable="@drawable/ic_truck"
            app:startIconTint="@color/naranja_boton"
            app:boxStrokeColor="@color/naranja_boton">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/operadorAnticipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nombre del Operador -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="16dp"
            android:hint="       Nombre del Operador"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@color/naranja_boton"
            app:boxStrokeColor="@color/naranja_boton">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nombreOperadorAnticipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Importe -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Importe"
            app:prefixText="$ "
            app:prefixTextColor="@color/naranja_boton"
            app:boxStrokeColor="@color/naranja_boton">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/importeAnticipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Concepto -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="16dp"
            android:hint="Concepto"
            app:boxStrokeColor="@color/naranja_boton">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/conceptoAnticipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Observaciones -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="32dp"
            android:hint="Observaciones"
            app:boxStrokeColor="@color/naranja_boton">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/observacionesAnticipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones Inferiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/atrasAnticipo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="ATRÁS"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="16dp"
                app:strokeColor="@android:color/white"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/guardarAnticipo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="REGISTRAR"
                app:backgroundTint="@color/naranja_boton"
                android:layout_marginStart="8dp"
                app:cornerRadius="16dp"
                app:elevation="4dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>