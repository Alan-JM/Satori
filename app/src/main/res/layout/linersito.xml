<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linersito"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="1"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_item_redondeado"
    android:layout_marginBottom="12dp"
    android:elevation="4dp">

    <!-- Nombre del operador -->
    <TextView
        android:id="@+id/nombreOperador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.45"
        android:text="Operador X"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/negro_suave"
        android:paddingEnd="6dp" />

    <!-- Icono enviado -->
    <ImageView
        android:id="@+id/enviado"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_weight="0.125"
        android:src="@drawable/doblecirculo"
        android:layout_marginEnd="6dp"
        app:tint="@color/naranja_boton" />

    <!-- Icono en progreso -->
    <ImageView
        android:id="@+id/oprogreso"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_weight="0.125"
        android:src="@drawable/triangulor"
        android:layout_marginEnd="6dp"
        app:tint="@color/naranja_boton" />

    <!-- Icono lápiz -->
    <ImageView
        android:id="@+id/lapiz"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_weight="0.125"
        android:src="@drawable/lapiz"
        android:layout_marginEnd="6dp"
        app:tint="@color/negro_suave" />

    <!-- Icono bote -->
    <ImageView
        android:id="@+id/bote"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_weight="0.125"
        android:src="@drawable/bote"
        app:tint="@color/negro_suave" />
</LinearLayout>
