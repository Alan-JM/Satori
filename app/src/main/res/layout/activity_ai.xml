<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Lista de mensajes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/layoutInputBar"
            android:divider="@android:color/transparent"
            android:padding="8dp"
            android:layout_marginTop="56dp"/> <!-- margen para que no quede debajo de la toolbar -->

        <!-- Barra inferior de entrada -->
        <LinearLayout
            android:id="@+id/layoutInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@color/blanco_hueso"
            android:elevation="4dp">

            <!-- Primera línea: campo de texto + micrófono -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/editTextTranscription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Escribe un mensaje..."
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:minLines="1"
                    android:padding="12dp"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:background="@drawable/bg_item_liquidacion"/>

                <Button
                    android:id="@+id/btnMic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎤"
                    android:textSize="18sp"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="@color/naranja_boton"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp"/>
            </LinearLayout>

            <!-- Segunda línea: botones de acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enviar"
                    app:backgroundTint="@color/naranja_boton"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="Regresar"
                    app:srcCompat="@drawable/ic_back_arrow"
                    app:tint="@color/naranja_boton"
                    android:elevation="4dp"/>
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
