<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grey"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalles del Anticipo"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Card con los datos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvFolioDetalleAnticipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Folio: "
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvFechaDetalleAnticipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fecha: "
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvOperadorDetalleAnticipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Unidad eco: "
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvNombreOperadorDetalleAnticipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre: "
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvImporteDetalleAnticipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Importe: "
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/orange"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvConceptoDetalleAnticipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Concepto: "
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvObservacionesDetalleAnticipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Observaciones: "
                        android:textSize="14sp"
                        android:textColor="@color/black"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModificarAnticipo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="MODIFICAR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/orange"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarAnticipo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="ENVIAR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/green"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarAnticipo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="ELIMINAR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="#F44336"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverAnticipo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="VOLVER"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/grey" />

    </LinearLayout>

</LinearLayout>
