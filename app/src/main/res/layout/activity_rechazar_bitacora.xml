<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/naranja_fondo"
    android:fillViewport="true"
    tools:context=".Bitacoras.Administrador.RechazarBitacoraActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motivo de Rechazo"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/rob_bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"/>

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explica detalladamente por qué se rechaza esta bitácora"
            android:textColor="@color/blanco_hueso"
            android:textSize="14sp"
            android:fontFamily="@font/rob_med"
            android:alpha="0.8"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Campo de Texto para Motivo -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="32dp"
            android:hint="Escribe el motivo aquí..."
            app:boxStrokeColor="@color/naranja_boton"
            app:hintTextColor="@color/blanco_hueso"
            android:textColorHint="@color/blanco_hueso"
            app:startIconTint="@color/naranja_boton">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/motivoRechazo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="5"
                android:gravity="top"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones Inferiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelarRechazo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="CANCELAR"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="16dp"
                app:strokeColor="@android:color/white"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/enviarRechazo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="ENVIAR"
                app:backgroundTint="#D32F2F"
                android:layout_marginStart="8dp"
                app:cornerRadius="16dp"
                app:elevation="4dp" />
        </LinearLayout>

        <!-- Copyright / Logo opcional al final -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/rob_norm"
            android:gravity="center"
            android:text="Aristo S.A.S. 2025"
            android:textColor="@color/blanco_hueso"
            android:textSize="12sp"
            android:alpha="0.6" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>