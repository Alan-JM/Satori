<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/naranja_fondo"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Logo centrado -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="20dp"
        app:srcCompat="@drawable/satoricd" />


    <!-- Botón Inicio de Sesión -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/InicioDeSesion"
        android:layout_width="match_parent"
      android:layout_marginTop="10dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="INICIO DE SESIÓN"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/naranja_boton"
        app:cornerRadius="16dp"
        app:elevation="4dp" />

    <!-- Texto intermedio -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/rob_med"
        android:gravity="center"
        android:text="¿Aún no estás registrado?"
        android:textColor="@color/blanco_hueso"
        android:textSize="13sp"
        android:alpha="0.8" />

    <!-- Botón Registro -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/Registro"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:text="REGISTRO"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:strokeColor="@android:color/white"
        app:strokeWidth="2dp" />

    <!-- Espaciador -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Copyright -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/rob_norm"
        android:gravity="center"
        android:text="Aristo S.A.S. 2025"
        android:textColor="@color/blanco_hueso"
        android:textSize="12sp"
        android:alpha="0.6" />

</LinearLayout>