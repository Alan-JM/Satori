<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_liquidacion">

    <!-- Folio | Fecha -->
    <TextView
        android:id="@+id/tvFolioFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Folio | Fecha"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:fontFamily="sans-serif-medium"/>

    <!-- Cliente - Destino -->
    <TextView
        android:id="@+id/tvClienteDestino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Cliente - Destino"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:fontFamily="sans-serif"/>

    <!-- Resumen generado -->
    <TextView
        android:id="@+id/tvResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Resumen generado"
        android:textSize="13sp"
        android:textColor="#FF9800"
        android:fontFamily="sans-serif"/>
</LinearLayout>
