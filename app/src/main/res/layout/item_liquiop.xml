<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_liquidacion">

    <!-- Folio | Fecha -->
    <TextView
        android:id="@+id/tvFolioFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Folio | Fecha"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"/>

    <!-- Cliente - Destino + Resumen en la misma fila -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvClienteDestino"
            android:layout_width="151dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cliente - Destino"
            android:textColor="@android:color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResumen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumen generado"
            android:textSize="13sp"
            android:textColor="#FF9800"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
