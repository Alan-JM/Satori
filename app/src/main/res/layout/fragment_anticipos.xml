<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="16dp"
    tools:context=".Anticipos.AnticiposFragment">

    <ListView
        android:id="@+id/anticiposRegistrados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="14dp"
        android:listSelector="@android:color/transparent"
        android:padding="4dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- Contenedor del interruptor con texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver anticipos procesados"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginEnd="12dp"/>

        <Switch
            android:id="@+id/switchVerAnticipos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/ic_nove"
            android:track="@android:color/transparent"
            android:background="@drawable/bg_switch_border"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/RegistrarAnticipo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Registrar Anticipo"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#AC5A2C"
        app:cornerRadius="28dp"
        app:backgroundTint="@android:color/white"
        android:elevation="4dp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
